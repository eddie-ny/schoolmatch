# Public values only. Never put the service-role key or database password in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Formspree form id for the complaint box, the part after /f/ in your form's endpoint (for example abcdwxyz). Public, safe in the browser.
VITE_FORMSPREE_ID=
# Sentry crash alerts. Copy the DSN from Sentry, Settings, Projects, your project, Client Keys. Public, safe in the browser. Leave empty to turn Sentry off.
VITE_SENTRY_DSN=
